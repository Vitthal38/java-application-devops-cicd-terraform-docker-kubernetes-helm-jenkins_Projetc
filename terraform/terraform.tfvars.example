# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it with real values.

region             = "ap-south-1"
project_name       = "java-devops"
environment        = "dev"
cluster_name       = "java-eks-cluster"
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3
